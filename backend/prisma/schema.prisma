generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @unique
  icon               String?
  businessCategories BusinessCategory[]

  @@map("categories")
}

model Business {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  logo               String?
  status             String             @default("active")
  createdAt          DateTime           @default(now()) @map("created_at")
  businessCategories BusinessCategory[]
  branches           Branch[]
  services           Service[]
  businessMembers    BusinessMember[]
  favorites          Favorite[]

  @@map("businesses")
}

model BusinessCategory {
  businessId String   @map("business_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@map("business_categories")
}

model Branch {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  name           String
  address        String
  city           String?
  latitude       Decimal         @db.Decimal(10, 7)
  longitude      Decimal         @db.Decimal(10, 7)
  phone          String?
  isActive       Boolean         @default(true) @map("is_active")
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchServices BranchService[]
  branchStaff    BranchStaff[]
  appointments   Appointment[]
  reviews        Review[]

  @@map("branches")
}

model Service {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  name           String
  description    String?
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchServices BranchService[]
  favorites      Favorite[]
  reviews        Review[]

  @@map("services")
}

model BranchService {
  id                  String               @id @default(uuid()) @db.Uuid
  branchId            String               @map("branch_id") @db.Uuid
  serviceId           String               @map("service_id") @db.Uuid
  price               Decimal              @db.Decimal(10, 2)
  durationMinutes     Int                  @map("duration_minutes")
  queueEnabled        Boolean              @default(true) @map("queue_enabled")
  appointmentEnabled  Boolean              @default(true) @map("appointment_enabled")
  isActive            Boolean              @default(true) @map("is_active")
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service             Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffServices       StaffService[]
  appointmentServices AppointmentService[]
  queueSessions       QueueSession[]

  @@unique([branchId, serviceId])
  @@map("branch_services")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  fullName        String           @map("full_name")
  email           String?          @unique
  phone           String           @unique
  avatarUrl       String?          @map("avatar_url")
  status          String           @default("active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  businessMembers BusinessMember[]
  favorites       Favorite[]
  userDevices     UserDevice[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]
  appointments    Appointment[]
  queueTokens     QueueToken[]
  reviews         Review[]

  @@map("users")
}

model BusinessMember {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  businessId  String        @map("business_id") @db.Uuid
  role        String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchStaff BranchStaff[]

  @@unique([userId, businessId])
  @@map("business_members")
}

model BranchStaff {
  id             String          @id @default(uuid()) @db.Uuid
  branchId       String          @map("branch_id") @db.Uuid
  memberId       String          @map("member_id") @db.Uuid
  status         String          @default("active")
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member         BusinessMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  staffServices  StaffService[]
  staffSchedules StaffSchedule[]
  appointments   Appointment[]
  queueTokens    QueueToken[]

  @@unique([branchId, memberId])
  @@map("branch_staff")
}

model StaffService {
  branchServiceId String        @map("branch_service_id") @db.Uuid
  branchStaffId   String        @map("branch_staff_id") @db.Uuid
  branchService   BranchService @relation(fields: [branchServiceId], references: [id], onDelete: Cascade)
  branchStaff     BranchStaff   @relation(fields: [branchStaffId], references: [id], onDelete: Cascade)

  @@id([branchServiceId, branchStaffId])
  @@map("staff_services")
}

model StaffSchedule {
  id            String      @id @default(uuid()) @db.Uuid
  branchStaffId String      @map("branch_staff_id") @db.Uuid
  dayOfWeek     Int         @map("day_of_week")
  startTime     DateTime    @map("start_time") @db.Time(0)
  endTime       DateTime    @map("end_time") @db.Time(0)
  isAvailable   Boolean     @default(true) @map("is_available")
  branchStaff   BranchStaff @relation(fields: [branchStaffId], references: [id], onDelete: Cascade)

  @@map("staff_schedules")
}

model Favorite {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  businessId String?   @map("business_id") @db.Uuid
  serviceId  String?   @map("service_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service    Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@unique([userId, serviceId])
  @@map("favorites")
}

model UserDevice {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  fcmToken String @map("fcm_token")
  platform String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_devices")
}

model OtpRequest {
  id         String   @id @default(uuid()) @db.Uuid
  phone      String
  otpCode    String   @map("otp_code")
  attempts   Int      @default(0)
  isVerified Boolean  @default(false) @map("is_verified")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_requests")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  message     String
  category    String
  referenceId String?   @map("reference_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  ticketNumber  String           @unique @map("ticket_number")
  category      String
  description   String
  attachmentUrl String?          @map("attachment_url")
  priority      String           @default("Medium")
  status        String           @default("In Progress")
  createdAt     DateTime         @default(now()) @map("created_at")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id           String        @id @default(uuid()) @db.Uuid
  ticketId     String        @map("ticket_id") @db.Uuid
  senderUserId String        @map("sender_user_id") @db.Uuid
  message      String
  createdAt    DateTime      @default(now()) @map("created_at")
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

model Appointment {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  branchId            String               @map("branch_id") @db.Uuid
  assignedStaffId     String?              @map("assigned_staff_id") @db.Uuid
  bookingNumber       String               @unique @map("booking_number")
  scheduledStart      DateTime             @map("scheduled_start")
  scheduledEnd        DateTime             @map("scheduled_end")
  status              String               @default("confirmed")
  cancellationReason  String?              @map("cancellation_reason")
  cancellationNotes   String?              @map("cancellation_notes")
  cancelledAt         DateTime?            @map("cancelled_at")
  checkedInAt         DateTime?            @map("checked_in_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedStaff       BranchStaff?         @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  appointmentServices AppointmentService[]
  appointmentEvents   AppointmentEvent[]
  queueToken          QueueToken?
  reviews             Review[]

  @@index([branchId, scheduledStart])
  @@map("appointments")
}

model AppointmentService {
  appointmentId   String        @map("appointment_id") @db.Uuid
  branchServiceId String        @map("branch_service_id") @db.Uuid
  price           Decimal       @db.Decimal(10, 2)
  durationMinutes Int           @map("duration_minutes")
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  branchService   BranchService @relation(fields: [branchServiceId], references: [id], onDelete: Restrict)

  @@id([appointmentId, branchServiceId])
  @@map("appointment_services")
}

model AppointmentEvent {
  id             String      @id @default(uuid()) @db.Uuid
  appointmentId  String      @map("appointment_id") @db.Uuid
  previousStatus String?     @map("previous_status")
  newStatus      String      @map("new_status")
  createdAt      DateTime    @default(now()) @map("created_at")
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_events")
}

model QueueSession {
  id                 String        @id @default(uuid()) @db.Uuid
  branchServiceId    String        @map("branch_service_id") @db.Uuid
  sessionDate        DateTime      @map("session_date") @db.Date
  startsAt           DateTime      @map("starts_at")
  endsAt             DateTime      @map("ends_at")
  status             String        @default("open")
  lastTokenNumber    Int           @default(0) @map("last_token_number")
  currentTokenNumber Int           @default(0) @map("current_token_number")
  branchService      BranchService @relation(fields: [branchServiceId], references: [id], onDelete: Cascade)
  queueTokens        QueueToken[]

  @@unique([branchServiceId, sessionDate])
  @@map("queue_sessions")
}

model QueueToken {
  id              String            @id @default(uuid()) @db.Uuid
  queueSessionId  String            @map("queue_session_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  assignedStaffId String?           @map("assigned_staff_id") @db.Uuid
  appointmentId   String?           @unique @map("appointment_id") @db.Uuid
  tokenNumber     Int               @map("token_number")
  tokenLetter     String            @default("A") @map("token_letter")
  tokenDisplay    String            @map("token_display")
  status          String            @default("waiting")
  joinedAt        DateTime          @default(now()) @map("joined_at")
  calledAt        DateTime?         @map("called_at")
  completedAt     DateTime?         @map("completed_at")
  queueSession    QueueSession      @relation(fields: [queueSessionId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedStaff   BranchStaff?      @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  appointment     Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  events          QueueTokenEvent[]
  reviews         Review[]

  @@unique([queueSessionId, tokenNumber])
  @@map("queue_tokens")
}

model QueueTokenEvent {
  id             String     @id @default(uuid()) @db.Uuid
  queueTokenId   String     @map("queue_token_id") @db.Uuid
  previousStatus String?    @map("previous_status")
  newStatus      String     @map("new_status")
  createdAt      DateTime   @default(now()) @map("created_at")
  queueToken     QueueToken @relation(fields: [queueTokenId], references: [id], onDelete: Cascade)

  @@map("queue_token_events")
}

model Review {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  branchId      String       @map("branch_id") @db.Uuid
  serviceId     String?      @map("service_id") @db.Uuid
  appointmentId String?      @map("appointment_id") @db.Uuid
  queueTokenId  String?      @map("queue_token_id") @db.Uuid
  rating        Int
  comment       String?
  tags          String[]     @default([])
  createdAt     DateTime     @default(now()) @map("created_at")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service       Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  queueToken    QueueToken?  @relation(fields: [queueTokenId], references: [id], onDelete: SetNull)

  @@map("reviews")
}
